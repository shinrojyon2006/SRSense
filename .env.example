# ==============================================================================
# SRSense AI — Environment Variables Template
# ==============================================================================

APP_NAME="SRSense AI"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 18)
POSTGRES_USER=srsense
POSTGRES_PASSWORD=srsense_secret_2026
POSTGRES_DB=srsense_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://srsense:srsense_secret_2026@localhost:5432/srsense_db

# Backend CORS
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
