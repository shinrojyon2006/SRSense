# ==============================================================================
# SRSense Backend — Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
# ==============================================================================

# Application
APP_NAME=SRSense AI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://srsense:srsense_secret_2026@localhost:5432/srsense_db

# Security & Secrets
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=300

# AI Provider: "heuristic" (default, CI-safe) | "gemini" | "openai"
AI_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
